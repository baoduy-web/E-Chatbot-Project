{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/scripts/_pyrun.sh\" \"$CLAUDE_PROJECT_DIR/scripts/hooks/guard_write.py\"",
            "timeout": 20
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/scripts/_pyrun.sh\" \"$CLAUDE_PROJECT_DIR/scripts/hooks/post_edit.py\"",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
